<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glowing layer: Soft cyan-blue ambient aura -->
    <path
        android:pathData="M 54,16 C 72,34 90,52 88,70 C 86,86 72,92 54,92 C 32,92 20,80 20,60 C 20,40 36,28 54,16 Z"
        android:fillColor="#1500C2FF" />

    <!-- Layer 1: Main outer flame body with premium cobalt-to-neon gradient -->
    <path
        android:pathData="M 54,18 C 70,34 86,52 84,68 C 82,82 70,88 54,88 C 34,88 22,78 22,60 C 22,42 38,30 54,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="88"
                android:endX="84"
                android:endY="18"
                android:type="linear">
                <item android:offset="0.0" android:color="#0022FF" />
                <item android:offset="0.5" android:color="#0066FF" />
                <item android:offset="1.0" android:color="#00C2FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layer 2: Inner liquid-depth flame layer with bright cyan-to-sky gradient -->
    <path
        android:pathData="M 54,26 C 64,40 76,54 74,66 C 72,76 64,82 54,82 C 40,82 32,74 32,58 C 32,46 44,36 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="82"
                android:endX="74"
                android:endY="26"
                android:type="linear">
                <item android:offset="0.0" android:color="#0047FF" />
                <item android:offset="0.5" android:color="#00A3FF" />
                <item android:offset="1.0" android:color="#00F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layer 3: Accent gloss overlay for high-end glassmorphic reflections -->
    <path
        android:pathData="M 54,28 C 61,38 72,48 71,58 C 70,68 60,74 54,74 C 44,74 38,68 38,54 C 38,44 46,36 54,28 Z"
        android:fillColor="#33FFFFFF" />

    <!-- Layer 4: Stylized premium white 'Z' negative-space overlay -->
    <path
        android:pathData="M 38,38 H 80 L 34,66 H 82 L 26,70 L 70,42 H 40 Z"
        android:fillColor="#FFFFFF" />

</vector>
