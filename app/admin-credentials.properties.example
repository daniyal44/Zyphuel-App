# ==============================================================================
# 🛡️ Zyphuel Public Admin Credentials Configuration Template
# ==============================================================================
# In accordance with the Strict Confidentiality & Zero Credential Leak Rule:
# Production admin credentials and passwords must NEVER be committed to Git.
#
# SETUP INSTRUCTIONS FOR AUTHORIZED ADMINISTRATORS:
# 1. Copy this template to: 'app/admin-credentials.properties' (strictly ignored by .gitignore).
# 2. Enter your secure salted admin password hash below.
# 3. DO NOT commit 'app/admin-credentials.properties' to any public git branch.
# ==============================================================================
ADMIN_EMAIL=m.daniyalkhan490@gmail.com
# SHA-256 hex (64 lowercase characters) of '<your password>' + the app PEPPER value.
# Leave EMPTY to disable the master-admin credential path entirely (fail-closed), and
# NEVER commit the real value: a published hash is an offline brute-force target.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Google App Password for the transactional Email Gateway (SMTP relay).
# Copy the real value into 'app/admin-credentials.properties' or export SMTP_APP_PASSWORD;
# this file is the tracked template and must stay empty. The value is hex-encoded into
# BuildConfig.SMTP_APP_PASSWORD_HEX and decoded by BuildSecrets, then re-applied to the
# encrypted admin enclave on every app launch, so a rotation shipped with an update needs no
# manual re-entry.
SMTP_APP_PASSWORD=
