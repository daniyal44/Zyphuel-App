rules_version = '2';

// =============================================================================
// Zyphuel — Cloud Firestore Production Security Rules (v2.6.4 Build 41)
// -----------------------------------------------------------------------------
// STATUS: ACTIVE & ENFORCED
// All clients are backed by authenticated Firebase Auth sessions (via Google OAuth
// or cryptographic anonymous bridging in FirebaseAuthProvider.ensureAuthSession).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'm.daniyalkhan490@gmail.com'
      );
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwnerEmail(email) {
      return isSignedIn() && (
        request.auth.token.email == email ||
        isAdmin()
      );
    }

    // ---- users/{uid} -------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();

      // Normal users can only register as 'customer' or 'rider'; role elevation to 'admin' is blocked
      allow create: if isSignedIn()
                    && request.resource.data.role in ['customer', 'rider'];

      allow update: if isAdmin()
                    || ( isOwnerUid(uid)
                         && request.resource.data.role == resource.data.role ); // role immutable by owner

      allow delete: if isAdmin() || isOwnerUid(uid);
    }

    // ---- orders/{orderId} --------------------------------------------------
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isOwnerEmail(resource.data.customerEmail)
        || isOwnerEmail(resource.data.riderEmail)
      );

      allow create: if isSignedIn()
                    && request.resource.data.status == 'Pending'
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice >= 0;

      // Price and customerEmail are strictly immutable after creation to prevent tampering
      allow update: if isSignedIn() && (
        isAdmin()
        || isOwnerEmail(resource.data.riderEmail)
        || isOwnerEmail(resource.data.customerEmail)
      )
      && request.resource.data.totalPrice == resource.data.totalPrice
      && request.resource.data.customerEmail == resource.data.customerEmail;

      allow delete: if isAdmin();
    }

    // ---- live_tracking/{orderId} (Rider GPS Telematics) ---------------------
    match /live_tracking/{orderId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- feedback/{id} -----------------------------------------------------
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---- audit_logs/{id} (Append-only security log) -------------------------
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Audit logs are immutable
    }

    // ---- system_config/** (SMTP & Gateway Credentials) ---------------------
    // Strictly restricted to Super Admin
    match /system_config/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- mail/{id} (Transactional Invoicing Gateway) ------------------------
    match /mail/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.to is list;
      allow update, delete: if isAdmin();
    }

    // ---- app_stats/{doc} (Public Install Counter) ---------------------------
    match /app_stats/{doc} {
      allow read:  if true;
      allow write: if isSignedIn();
    }

    // ---- Default: Deny everything not explicitly matched --------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
