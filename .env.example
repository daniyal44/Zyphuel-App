# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Google "Maps SDK for Android" key for live map tiles.
# Must NOT be left blank - an empty value generates invalid Java in BuildConfig
# (String MAPS_API_KEY = ;) and the build fails. Keep the placeholder, or replace it
# with a real key to enable native Google Maps tiles. The live tracking map itself
# (Leaflet WebView) works without a key. Injected into AndroidManifest as ${MAPS_API_KEY}.
MAPS_API_KEY=PLACEHOLDER_MAPS_API_KEY

# SMTP_APP_PASSWORD: Google App Password for the transactional Email Gateway relay.
# NEVER put the real value here in a tracked file: write it into the git-ignored .env
# (or app/admin-credentials.properties) locally, and into the GitHub Actions secret
# SMTP_APP_PASSWORD for CI. Empty means "no packaged credential" — the gateway then
# relies on the admin-managed Firestore config.
# NOTE: the key is deliberately NOT declared in this template. The secrets Gradle plugin
# mirrors every key of this file into BuildConfig, and an empty SMTP_APP_PASSWORD= becomes
# `public static final String SMTP_APP_PASSWORD = ;`, which fails compileDebugJavaWithJavac
# ("illegal start of expression"). Provide the value in the git-ignored
# app/admin-credentials.properties / local.properties, or the GitHub Actions secret.
# Omit the key entirely to build without a packaged credential.
